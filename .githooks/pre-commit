#!/bin/sh
# miaoda vite-react: pre-commit — 通用入口，具体门禁内容由 package.json 的 precommit 脚本决定
# 注册（core.hooksPath=.githooks）由 package.json 的 prepare 脚本在 npm install 时完成，
# fullstack upgrade 的 activateGitHooks 作为兜底（覆盖 install 早于 git init 的时序）。
[ "$SKIP_GIT_HOOKS" = "1" ] && exit 0

# 2026-10-20 修：本机（DSH runtime）装了 node 但没有 npm/npm.cmd，原逻辑会直接「跳过校验」放行，
# 等于门禁形同虚设。改为三级兜底：
#   ① npm / npm.cmd（正常安装）→ npm run precommit
#   ② 只有 node（无 npm）→ 直接跑 node_modules/.bin 里的 tsc + eslint，等价于 npm run lint
#   ③ 连 node 都找不到 → 才跳过（并明确提示）
if command -v npm >/dev/null 2>&1; then
  NPM=npm
elif command -v npm.cmd >/dev/null 2>&1; then
  NPM=npm.cmd
elif command -v node >/dev/null 2>&1; then
  echo "› pre-commit: 无 npm，改用 node 直跑 tsc + eslint（等价 npm run lint）" >&2
  # typecheck（tsconfig.app.json 与本仓库 build 链路一致）
  if [ -x node_modules/.bin/tsc ]; then
    node_modules/.bin/tsc --noEmit -p tsconfig.app.json || { echo "✗ pre-commit: typecheck 未通过" >&2; exit 1; }
  else
    node node_modules/typescript/bin/tsc --noEmit -p tsconfig.app.json || { echo "✗ pre-commit: typecheck 未通过" >&2; exit 1; }
  fi
  # eslint（只报错级，warning 不拦）
  if [ -f node_modules/eslint/bin/eslint.js ]; then
    node node_modules/eslint/bin/eslint.js src --max-warnings=9999 || { echo "✗ pre-commit: eslint 有 error" >&2; exit 1; }
  fi
  echo "✓ pre-commit: 校验通过（tsc + eslint）" >&2
  exit 0
else
  echo "⚠ pre-commit: PATH 中既找不到 npm 也找不到 node，本次跳过校验。装好 Node.js 后会自动恢复强制校验。" >&2
  exit 0
fi

if ! $NPM run precommit; then
  echo "✗ pre-commit: 校验未通过，已阻断提交（绕过：git commit --no-verify 或 SKIP_GIT_HOOKS=1）" >&2
  exit 1
fi
